{
  "version": "1.0.0",
  "updated": "2026-04-02T00:00:00Z",
  "description": "Built-in tool guard patterns shipped with Shroud. Loaded at runtime to avoid OC scanner flagging string literals in JS/TS source.",
  "toolGuardPatterns": [
    {
      "id": "ext_tg_rm_rf",
      "toolName": null,
      "paramPattern": "\\brm\\s+(?:-[a-zA-Z]*[rf][a-zA-Z]*\\s+)(?:\\/|~|\\$HOME|\\.\\.|\\.\\/)",
      "flags": "gi",
      "severity": "high",
      "description": "Destructive: rm -rf on significant path",
      "block": true
    },
    {
      "id": "ext_tg_shutdown",
      "toolName": null,
      "paramPattern": "\\b(?:shutdown|poweroff|halt|reboot|init\\s+[06])\\b",
      "flags": "gi",
      "severity": "high",
      "description": "Destructive: system shutdown/reboot command",
      "block": true
    },
    {
      "id": "ext_tg_format_disk",
