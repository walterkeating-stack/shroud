# Sandbox test image: adds Docker daemon to the test image.
# Built only when --sandbox flag is passed to run-compat.sh.
#
# Provides Docker-in-Docker so OpenClaw can run agent exec calls
# inside containers (exec.host: "sandbox").
#
# Uses regular dockerd (not rootless) with vfs storage driver.
# The --internal network prevents any egress, and SYS_ADMIN cap
# is contained to the isolated test container.
#
# Build:
#   docker build --build-arg OC_VERSION=2026.3.28 \
#     -t shroud-compat-sandbox:oc-2026.3.28 -f compat/Dockerfile.sandbox .

ARG OC_VERSION
FROM shroud-compat:oc-${OC_VERSION}

# Install Docker CE
RUN apt-get update -qq && \
    apt-get install -y -qq curl ca-certificates >/dev/null 2>&1 && \
    curl -fsSL https://get.docker.com | sh 2>/dev/null && \
    rm -rf /var/lib/apt/lists/* && \
    echo "Docker installed"

# Copy sandbox entrypoint
COPY compat/entrypoint-sandbox.sh /shroud/entrypoint-sandbox.sh
RUN chmod +x /shroud/entrypoint-sandbox.sh

# Sandbox env
ENV SHROUD_TEST_SANDBOX=1

ENTRYPOINT ["/shroud/entrypoint-sandbox.sh"]
