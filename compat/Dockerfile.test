# Test image: install Shroud from npm on top of a base image.
# Both OpenClaw and Shroud come from npm — same as real users.
#
# Build:
#   docker build --build-arg OC_VERSION=2026.3.24 --build-arg SHROUD_VERSION=2.2.9 \
#     -t shroud-compat:oc-2026.3.24 -f compat/Dockerfile.test .

ARG OC_VERSION
FROM shroud-compat-base:oc-${OC_VERSION}

ARG SHROUD_VERSION=latest

# Install Shroud from npm — exactly what users do
RUN npm install -g shroud-privacy@${SHROUD_VERSION} && \
    echo "Shroud ${SHROUD_VERSION} installed from npm"

# Copy test harness (not the unit tests — just the openclaw runner + scenarios)
COPY tests/harness/ /shroud/tests/harness/

# Copy compat scripts
COPY compat/entrypoint.sh /shroud/entrypoint.sh
RUN chmod +x /shroud/entrypoint.sh

# Environment
ENV NODE_ENV=test
ENV SHROUD_STATS_FILE=/shroud/state/shroud-stats.json
ENV HOME=/shroud
ENV SHROUD_VERSION=${SHROUD_VERSION}

# No host network, no volume mounts, no secrets
# Everything the test needs is baked into the image

ENTRYPOINT ["/shroud/entrypoint.sh"]
