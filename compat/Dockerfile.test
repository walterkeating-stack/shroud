# Test image: install Shroud from local build (feature branch).
# OpenClaw comes from npm, Shroud from the local tarball.
#
# Build:
#   npm pack && docker build --build-arg OC_VERSION=2026.3.28 \
#     -t shroud-compat:oc-2026.3.28 -f compat/Dockerfile.test .

ARG OC_VERSION
FROM shroud-compat-base:oc-${OC_VERSION}

# Install Shroud from local tarball (packed from feature branch)
COPY shroud-privacy-*.tgz /tmp/shroud-local.tgz
RUN npm install -g /tmp/shroud-local.tgz && \
    rm /tmp/shroud-local.tgz && \
    echo "Shroud installed from local build"

# Copy test harness (not the unit tests — just the openclaw runner + scenarios)
COPY tests/harness/ /shroud/tests/harness/

# Copy compat scripts
COPY compat/entrypoint.sh /shroud/entrypoint.sh
RUN chmod +x /shroud/entrypoint.sh

# Security extension environment
ENV NODE_ENV=test
ENV SHROUD_STATS_FILE=/shroud/state/shroud-stats.json
ENV HOME=/shroud
ENV SHROUD_INJECTION_DETECTION=flag
ENV SHROUD_INJECTION_SCAN_RESPONSES=true
ENV SHROUD_INJECTION_MIN_SEVERITY=low
ENV SHROUD_PROFILING_ENABLED=true
ENV SHROUD_PROFILING_MODE=learning
ENV SHROUD_DASHBOARD=true
ENV SHROUD_DASHBOARD_PORT=9380
ENV SHROUD_CANARY_ENABLED=true
ENV SHROUD_CANARY_SYSTEM=true

# No host network, no volume mounts, no secrets
# Everything the test needs is baked into the image

ENTRYPOINT ["/shroud/entrypoint.sh"]
