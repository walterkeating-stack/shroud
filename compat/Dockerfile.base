# Base image for OpenClaw compatibility testing.
# One image per OpenClaw version. Cached in registry/locally.
#
# Build:
#   docker build --build-arg OC_VERSION=2026.3.24 \
#     -t shroud-compat-base:oc-2026.3.24 -f compat/Dockerfile.base .

FROM node:22-slim

ARG OC_VERSION
ENV OC_VERSION=${OC_VERSION}

# python3 is needed by OpenClaw's plugin install (post-install hooks)
# iptables is needed for NAT rules (OC 2026.4.1+ URL processing)
# /etc/hosts must be writable for channel E2E mock redirects
RUN apt-get update -qq && apt-get install -y -qq python3 iptables >/dev/null 2>&1 && \
    rm -rf /var/lib/apt/lists/* && \
    chmod 666 /etc/hosts

# Install OpenClaw globally (the expensive step — cached per version)
# Also install optional deps that newer OC builds may lazy-load from bundled extensions.
# Install each independently so one failure doesn't skip the others.
RUN npm install -g openclaw@${OC_VERSION} && \
    (npm install -g @slack/web-api@7 || true) && \
    (npm install -g @slack/bolt@4 || true) && \
    (npm install -g @aws-sdk/client-bedrock@3 || true) && \
    (npm install -g @buape/carbon || true) && \
    (npm install -g @larksuiteoapi/node-sdk || true) && \
    (npm install -g grammy || true) && \
    openclaw --version && \
    echo "OpenClaw ${OC_VERSION} installed"

# Create working directories
RUN mkdir -p /shroud/state /shroud/extensions/shroud-privacy

# Health check marker
RUN echo "${OC_VERSION}" > /shroud/.oc-version

WORKDIR /shroud
