[
  {
    "name": "Hostname role preservation — CORE RTR",
    "input": "hostname CHI-CORE-RTR-01\ninterface GigabitEthernet0/0/0\n ip address 10.0.0.1 255.255.255.252\n description UPLINK TO NYC-CORE-RTR-02",
    "assertions": {
      "llm_must_not_see": ["CHI-CORE-RTR-01", "NYC-CORE-RTR-02", "10.0.0.1"],
      "user_must_see": ["CHI-CORE-RTR-01", "NYC-CORE-RTR-02", "10.0.0.1"],
      "entity_count_min": 2,
      "no_cgnat_leak": true,
      "roundtrip": true
    }
  },
  {
    "name": "Hostname role preservation — DIST SW",
