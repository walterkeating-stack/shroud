  {
    "name": "Full VRF + interface block",
    "input": "ip vrf CUST-ALPHA\n rd 65001:100\n route-target export 65001:100\n route-target import 65001:100\n!\ninterface GigabitEthernet0/1\n description LINK TO Customer Alpha via Dark Fiber\n ip vrf forwarding CUST-ALPHA\n ip address 10.99.1.1 255.255.255.252",
    "assertions": {
      "llm_must_not_see": ["CUST-ALPHA", "65001:100", "10.99.1.1"],
      "user_must_see": ["CUST-ALPHA", "65001:100", "10.99.1.1"],
      "entity_count_min": 4,
      "no_cgnat_leak": true,
      "roundtrip": true
    }
  }
