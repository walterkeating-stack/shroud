[
  {
    "name": "VRF: ip vrf name",
    "input": "ip vrf CUST-ALPHA-VRF",
    "assertions": {
      "llm_must_not_see": ["CUST-ALPHA-VRF"],
      "user_must_see": ["CUST-ALPHA-VRF"],
      "entity_count_min": 1,
      "categories": ["vlan_id"],
      "roundtrip": true
    }
  },
  {
    "name": "VRF: definition",
    "input": "vrf definition MGMT-VRF",
    "assertions": {
      "llm_must_not_see": ["MGMT-VRF"],
