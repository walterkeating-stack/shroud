{
  "name": "openclaw-shroud",
  "version": "1.5.1",
  "description": "Privacy obfuscation plugin for OpenClaw and NCG — deterministic fake values with deobfuscation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "ncg_adapter.py",
    "shroud_bridge.mjs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "ncg",
    "privacy",
    "pii",
    "obfuscation",
    "llm",
    "redaction"
  ],
  "author": "walterkeating-stack",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.4",
    "vitest": "^2.0",
    "@types/node": "^20"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walterkeating-stack/shroud.git"
  },
  "homepage": "https://github.com/walterkeating-stack/shroud#readme",
  "bugs": {
    "url": "https://github.com/walterkeating-stack/shroud/issues"
  }
}
